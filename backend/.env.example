# Server
PORT=5000
JWT_SECRET=replace-with-a-long-random-string
# Optional: comma-separated list of allowed browser origins (leave empty for local dev)
CORS_ORIGIN=
# Set to 1 when deploying behind nginx/caddy so rate limiters see real client IPs
# TRUST_PROXY=1

# MySQL database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=cohort_erp
# Database TLS/SSL (Required for TiDB Cloud; leave false/unset for local MySQL)
DB_SSL=false
# Required when DB_SSL=true: PEM certificate content (or path to CA certificate)
DB_SSL_CA=

# Password reset email (optional)
# Without SMTP, the reset link is printed to the server console (dev mode).
# With SMTP, any provider works (Gmail app password, Elastic Email, Resend SMTP, ...).
FRONTEND_URL=http://localhost:5000
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Admin account created by `npm run seed`
ADMIN_NAME=System Admin
ADMIN_EMAIL=admin@cime.edu
ADMIN_PASSWORD=password
